{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLVNR local model kit",
  "type": "object",
  "required": ["schema_version", "kit_id", "model_ids", "catalog_sha256", "files", "models"],
  "properties": {
    "schema_version": {"const": 1},
    "kit_id": {"type": "string"},
    "created_at": {"type": "string"},
    "model_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "total_bytes": {"type": "integer", "minimum": 0},
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["manifest_sha256", "source_model_sha256"],
        "properties": {
          "manifest_sha256": {"type": "string"},
          "source_model_sha256": {"type": "string"},
          "files": {"type": "object"}
        }
      }
    }
  }
}
